# ================================
# SERVER CONFIGURATION
# ================================
NODE_ENV=development
PORT=5001

# ================================
# DATABASE
# ================================
MONGO_URI=mongodb://localhost:27017/ecommerce

# ================================
# JWT AUTHENTICATION
# ================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=30d

# ================================
# FRONTEND URL (For CORS & Email Links)
# ================================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173

# ================================
# EMAIL CONFIGURATION (Resend)
# ================================
RESEND_API_KEY=re_xxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# ================================
# PAYMENT GATEWAYS
# ================================

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=

# Cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_PRODUCTION=false

# Stripe (if used)
STRIPE_SECRET_KEY=

# ================================
# REDIS (For Background Jobs)
# ================================
# Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloud Redis (Upstash, Redis Cloud, etc.)
# REDIS_URL=redis://default:password@host:port
# REDIS_TLS=true

# ================================
# GOOGLE OAUTH
# ================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ================================
# FIREBASE (For Push Notifications - Optional)
# ================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ================================
# CLOUDINARY / CDN (For Image Uploads - Optional)
# ================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ================================
# COMMISSION & SETTLEMENT
# ================================
DEFAULT_COMMISSION_RATE=10
SETTLEMENT_HOLD_DAYS=7
MIN_SETTLEMENT_AMOUNT=100
AUTO_APPROVE_THRESHOLD=5000

# ================================
# GST & TAX
# ================================
GST_RATE=18
TDS_RATE=1

# ================================
# FRAUD DETECTION
# ================================
FRAUD_THRESHOLD_AMOUNT=50000
MAX_DAILY_COUPON_USAGE=50

# ================================
# PERFORMANCE TRACKING
# ================================
# Commissions are automatically reduced based on performance tier:
# PLATINUM: -3%, GOLD: -2%, SILVER: -1%, BRONZE/STANDARD: 0%
